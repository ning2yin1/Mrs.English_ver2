{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://mrs-english.local/schemas/examples.schema.json",
  "type": "array",
  "minItems": 600,
  "maxItems": 600,
  "items": {
    "$ref": "#/$defs/example"
  },
  "$defs": {
    "block": {
      "type": "object",
      "required": [
        "id",
        "text",
        "role"
      ],
      "properties": {
        "id": {
          "type": "string"
        },
        "text": {
          "type": "string",
          "minLength": 1
        },
        "role": {
          "enum": [
            "required",
            "distractor"
          ]
        }
      }
    },
    "order": {
      "type": "object",
      "required": [
        "blocks",
        "correctOrder",
        "acceptedOrders",
        "instructionJa"
      ],
      "properties": {
        "blocks": {
          "type": "array",
          "minItems": 2,
          "items": {
            "$ref": "#/$defs/block"
          }
        },
        "correctOrder": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "acceptedOrders": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "array",
            "items": {
              "type": "string"
            }
          }
        },
        "instructionJa": {
          "type": "string"
        },
        "distractorBlocks": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/block"
          }
        }
      }
    },
    "easy": {
      "type": "object",
      "required": [
        "prompt",
        "blank",
        "options",
        "correctOptionId"
      ],
      "properties": {
        "prompt": {
          "type": "string"
        },
        "blank": {
          "type": "object",
          "required": [
            "start",
            "endExclusive",
            "answer"
          ],
          "properties": {
            "start": {
              "type": "integer",
              "minimum": 0
            },
            "endExclusive": {
              "type": "integer",
              "minimum": 1
            },
            "answer": {
              "type": "string"
            }
          }
        },
        "options": {
          "type": "array",
          "minItems": 4,
          "maxItems": 4,
          "items": {
            "type": "object",
            "required": [
              "id",
              "text",
              "isCorrect",
              "explanationJa"
            ],
            "properties": {
              "id": {
                "type": "string"
              },
              "text": {
                "type": "string"
              },
              "isCorrect": {
                "type": "boolean"
              },
              "explanationJa": {
                "type": "string"
              }
            }
          }
        },
        "correctOptionId": {
          "type": "string"
        }
      }
    },
    "example": {
      "type": "object",
      "required": [
        "id",
        "grammarId",
        "grammarNameJa",
        "english",
        "translationJa",
        "fictionalScenario",
        "grammarFocus",
        "sentenceExplanationJa",
        "glossary",
        "easy",
        "normal",
        "hard",
        "audio"
      ],
      "properties": {
        "id": {
          "type": "string",
          "pattern": "^G[0-9]{2}-E[0-9]{2}$"
        },
        "grammarId": {
          "type": "string",
          "pattern": "^G[0-9]{2}$"
        },
        "grammarNameJa": {
          "type": "string"
        },
        "english": {
          "type": "string",
          "minLength": 1
        },
        "translationJa": {
          "type": "string",
          "minLength": 1
        },
        "fictionalScenario": {
          "const": true
        },
        "grammarFocus": {
          "type": "object",
          "required": [
            "text",
            "start",
            "endExclusive",
            "explanationJa"
          ]
        },
        "sentenceExplanationJa": {
          "type": "string"
        },
        "glossary": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "object",
            "required": [
              "expression",
              "meaningJa",
              "kind"
            ]
          }
        },
        "easy": {
          "$ref": "#/$defs/easy"
        },
        "normal": {
          "$ref": "#/$defs/order"
        },
        "hard": {
          "$ref": "#/$defs/order"
        },
        "audio": {
          "type": "object",
          "required": [
            "id",
            "text",
            "lang",
            "rate",
            "pitch",
            "preRecordedPath"
          ],
          "properties": {
            "id": {
              "type": "string"
            },
            "text": {
              "type": "string"
            },
            "lang": {
              "const": "en-US"
            },
            "rate": {
              "type": "number",
              "minimum": 0.1,
              "maximum": 2
            },
            "pitch": {
              "type": "number"
            },
            "preRecordedPath": {
              "type": [
                "string",
                "null"
              ]
            }
          }
        }
      }
    }
  }
}
